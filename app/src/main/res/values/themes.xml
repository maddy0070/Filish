<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The visible interface is built entirely in Compose. These platform themes
      exist only to control the window itself: FILISH paints edge to edge and
      supplies its own system-bar treatment, so the platform decoration is
      stripped rather than styled.
    -->
    <style name="Theme.Filish" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <!--
      The launch window.

      From Android 12 the system draws a splash screen on every cold start
      whether an app asks for one or not. Before this was configured, FILISH
      got the default treatment - the launcher icon on a plain window - and
      then played its own opening afterwards. Two openings in a row, neither
      related to the other, which reads as a stutter rather than an entrance.

      So the system splash is now FILISH's own mark on FILISH's own ground, and
      the Compose opening continues from exactly that image: the same three
      strata, in the same place, which then stretch into the first rows of the
      list. One continuous move, not two unrelated ones.
    -->
    <style name="Theme.Filish.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Filish</item>
    </style>
</resources>
